{
  "manifest_version": 3,
  "name": "Arcee",
  "version": "0.2.0",
  "description": "Lets the Arcee desktop agent read and act on web pages, on request, through a local helper.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
